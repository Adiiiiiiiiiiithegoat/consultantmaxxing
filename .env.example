# Copy to .env and fill in. Never commit .env.

# Primary provider (free tier for now). Several keys may be given comma-separated
# (key1,key2,...): each gets its own rate-limit state and calls rotate across them.
# Limits are per Groq organization, so only keys from different orgs add capacity.
GROQ_API_KEY=

# Optional: local models via Ollama (no key needed)
OLLAMA_BASE_URL=http://localhost:11434

# Optional, for later: swap in by changing config/models.yaml
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional search providers (default is keyless DuckDuckGo via ddgs)
TAVILY_API_KEY=
BRAVE_API_KEY=

# Optional: comma-separated models the client must refuse (e.g. reserved for a running eval)
CONSULTANT_BLOCK_MODELS=
