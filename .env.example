# Copy to .env and fill in. Never commit .env.

# Primary provider (free tier for now)
GROQ_API_KEY=

# Optional: local models via Ollama (no key needed)
OLLAMA_BASE_URL=http://localhost:11434

# Optional, for later: swap in by changing config/models.yaml
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional search providers (default is keyless DuckDuckGo via ddgs)
TAVILY_API_KEY=
BRAVE_API_KEY=
